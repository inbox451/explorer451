server:
  address: ":8080"

aws:
  region: "us-east-1"
  endpoint_url: "http://localhost:4566"  # For LocalStack, remove for real AWS

log:
  level: "info"
  format: "json"

# Database configuration (optional)
# If not provided, the application will run without authentication
database:
  url: "postgres://user:password@localhost:5432/explorer451?sslmode=disable"
  max_open_conns: 25
  max_idle_conns: 5
  conn_max_lifetime: "5m"

# OIDC configuration (optional)
# Only used if database is configured
oidc:
  enabled: false
  provider_url: "https://your-oidc-provider.com"
  redirect_url: "http://localhost:8080/api/auth/oidc/callback"
  client_id: "your-client-id"
  client_secret: "your-client-secret"